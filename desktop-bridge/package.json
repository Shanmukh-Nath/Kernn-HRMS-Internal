{
  "name": "kernn-sync-bridge",
  "version": "1.0.0",
  "description": "Kernn Biometric Hardware Gateway for macOS and Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node clean-build.js",
    "prebuild:win": "node clean-build.js",
    "build:mac": "electron-builder --mac",
    "build:win": "node clean-build.js && electron-builder --win && node sign-installer.js",
    "build": "electron-builder -mw"
  },
  "keywords": ["biometric", "secureye", "hrms", "sync", "electron"],
  "author": "Kernn Automations Pvt. Ltd.",
  "license": "MIT",
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.kernn.syncbridge",
    "productName": "Kernn Sync Bridge",
    "copyright": "Copyright © 2026 Kernn Automations Pvt. Ltd. All rights reserved.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "icon.png",
      "minimumSystemVersion": "10.13.0",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "dmg": {
      "title": "Kernn Sync Bridge",
      "iconSize": 128,
      "contents": [
        { "x": 140, "y": 180, "type": "file" },
        { "x": 380, "y": 180, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "icon": "icon.ico",
      "legalTrademarks": "Kernn Automations Pvt. Ltd.",
      "publisherName": "Kernn Automations Pvt. Ltd.",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "highestAvailable"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Kernn Sync Bridge",
      "menuCategory": "Kernn Automations",
      "runAfterFinish": true,
      "uninstallDisplayName": "Kernn Sync Bridge - Biometric Hardware Gateway",
      "deleteAppDataOnUninstall": false
    }
  }
}
