{
  "name": "kernn-sync-bridge",
  "version": "1.0.0",
  "description": "Cross-Platform Biometric Hardware Sync Bridge for Kernn HRMS (Windows & macOS)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test-pull": "node device-puller.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build": "electron-builder -mw"
  },
  "keywords": ["biometric", "secureye", "hrms", "sync"],
  "author": "Kernn Automations",
  "license": "MIT",
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.kernn.syncbridge",
    "productName": "Kernn Sync Bridge",
    "mac": {
      "category": "public.app-category.business",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "win": {
      "target": ["nsis", "portable"]
    }
  }
}
